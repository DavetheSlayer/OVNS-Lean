import OddViscousNS.Closed.Row.Core

/-!
# Kernel-side row test of the matrix band

The direct low zone and the rational `2 × 2` test.  No Mathlib here.  Specification: `Row/Check.lean`.
-/

namespace OVNS
namespace Row

/-! ### The direct low zone -/

/-- Ceiling division. -/
noncomputable def cdiv (n d : Nat) : Nat := Nat.div (Nat.add n (Nat.sub d 1)) d

/-- Squared distance. -/
noncomputable def sqd (a b : Nat) : Nat :=
  lit (Nat.add (Nat.sub a b) (Nat.sub b a)) (fun d => Nat.mul d d)

/-- `1000 h(j)` for `j ≥ 1`. -/
noncomputable def metric (j : Nat) : Nat :=
  Bool.rec (motive := fun _ => Nat) (Nat.add (Nat.mul 290 j) 234)
    (Nat.land (Nat.shiftRight 1946468982229556158936808991710867550269958628223751857271405297982605532006507214853860686085941349358809191330973857719034716548882510184137486583792616 (Nat.mul 16 (Nat.sub j 1))) 65535) (Nat.ble j 32)

/-- `10⁵ λ(j)`. -/
noncomputable def root (j : Nat) : Nat :=
  Bool.rec (motive := fun _ => Nat) 100000
    (Nat.land (Nat.shiftRight  (Nat.mul 17 j)) 131071) (Nat.ble j 120)

/-- The scale of the low weights. -/
def lowS : Nat := 1267650600228229401496703205376

/-- The slot base of the packed low sum, `Y = 2^128`. -/
def lowB : Nat := 128

/-- The packed product: slots `f₁ w_s, f₁ w_r, f₁ w_t, f₂ w_s, f₂ w_r, f₂ w_t`, and their sum,
base `2^128`. -/
noncomputable def ltPack (f1 f2 wr ws wt : Nat) : Nat :=
  Nat.add (Nat.mul (Nat.add f1 (Nat.shiftLeft f2 384))
      (Nat.add ws (Nat.add (Nat.shiftLeft wr 128) (Nat.shiftLeft wt 256))))
    (Nat.shiftLeft (Nat.mul (Nat.add f1 f2) (Nat.add ws (Nat.add wr wt))) 768)

/-- The three squares from the two signed linear forms `u₁ - v₁ = p·r`, `u₂ - v₂ = p·s`. -/
noncomputable def ltW (f1 f2 u1 v1 u2 v2 : Nat) : Nat :=
  lit (sqd u1 v1) (fun wr => lit (sqd u2 v2) (fun ws =>
    lit (sqd (Nat.add u1 u2) (Nat.add v1 v2)) (fun wt => ltPack f1 f2 wr ws wt)))

/-- The linear forms of the low point `(ix,iy,iz) - 10`. -/
noncomputable def ltL (a b Q ac bc ix iy iz f1 f2 : Nat) : Nat :=
  ltW f1 f2 (Nat.add (Nat.mul a iy) (Nat.mul 10 b)) (Nat.add (Nat.mul b ix) (Nat.mul 10 a))
    (Nat.add (Nat.mul Q iz) (Nat.mul 10 (Nat.add ac bc)))
    (Nat.add (Nat.add (Nat.mul ac ix) (Nat.mul bc iy)) (Nat.mul 10 Q))

/-- The two weights. -/
noncomputable def ltF (a b Q ac bc ix iy iz wt den n1 n2 : Nat) : Nat :=
  lit (Nat.mul wt (cdiv (Nat.mul lowS n1) den)) (fun f1 =>
    lit (Nat.mul wt (cdiv (Nat.mul lowS n2) den)) (fun f2 =>
      ltL a b Q ac bc ix iy iz f1 f2))

/-- `n₂`, from `A, B, C` and the metric values. -/
noncomputable def ltN2 (A B C HA HB HC : Nat) : Nat :=
  Nat.add (sqd (Nat.add (Nat.mul A HC) (Nat.add (Nat.mul B HA) (Nat.mul C HB)))
               (Nat.add (Nat.mul A HB) (Nat.add (Nat.mul B HC) (Nat.mul C HA))))
    (Nat.mul (Nat.mul A B) (sqd HA HB))

/-- `n₁`. -/
noncomputable def ltN1 (A B HA HB HC : Nat) : Nat :=
  Nat.add (Nat.mul B (sqd HC HB)) (Nat.mul A (sqd HA HC))

/-- The denominator. -/
noncomputable def ltD (A B HA HB rr : Nat) : Nat :=
  Nat.mul (Nat.mul rr rr) (Nat.mul (Nat.mul (Nat.mul A A) (Nat.mul B B)) (Nat.mul HA HB))

/-- The metric part. -/
noncomputable def ltM (a b Q ac bc C HC rC ix iy iz A B HA HB : Nat) : Nat :=
  ltF a b Q ac bc ix iy iz (Bool.rec (motive := fun _ => Nat) 2 1 (Nat.ble B 120))
    (ltD A B HA HB (Nat.add (Nat.add (root A) (root B)) rC))
    (ltN1 A B HA HB HC) (ltN2 A B C HA HB HC)

/-- The packed contribution of the low point `p = (ix,iy,iz) - 10`, `A = |p|² ≠ 0`, at the row
`k = (a,b,c)` with `C = |k|²`, `HC = 1000 h_C`, `rC = 10⁵ λ_C`, `Q = a²+b²`, `ac = a c`, `bc = b c`. -/
noncomputable def lowTerm (a b c C HC rC Q ac bc ix iy iz A : Nat) : Nat :=
  lit (Nat.add (sqd (Nat.add a 10) ix) (Nat.add (sqd (Nat.add b 10) iy) (sqd (Nat.add c 10) iz)))
    (fun B => Bool.rec (motive := fun _ => Nat)
      (lit (metric B) (fun HB => ltM a b Q ac bc C HC rC ix iy iz A B (metric A) HB))
      0 (Nat.ble B 0))

/-- One step of the `z` loop. -/
noncomputable def lowZ (a b c C HC rC Q ac bc ix iy xy iz : Nat) : Nat :=
  lit (Nat.add xy (sqd iz 10)) (fun A =>
    Bool.rec (motive := fun _ => Nat) 0
      (Bool.rec (motive := fun _ => Nat) (lowTerm a b c C HC rC Q ac bc ix iy iz A) 0
        (Nat.ble A 0))
      (Nat.ble A 120))

/-- The packed low sum of a row. -/
noncomputable def lowSum (a b c C HC rC Q ac bc : Nat) : Nat :=
  pkB 0 (fun ix => lit (sqd ix 10) (fun xx =>
    pkB 0 (fun iy => lit (Nat.add xx (sqd iy 10)) (fun xy =>
      Bool.rec (motive := fun _ => Nat) 0
        (pkB 0 (lowZ a b c C HC rC Q ac bc ix iy xy) 21 5 0)
        (Nat.ble xy 120))) 21 5 0)) 21 5 0

/-- `10⁹ g_C`: the table for `C < 1024`, then the two band prices. -/
noncomputable def gN (C : Nat) : Nat :=
  Bool.rec (motive := fun _ => Nat)
    (Bool.rec (motive := fun _ => Nat) 172754764 163043000 (Nat.ble 3600 C))
    (Nat.land (Nat.shiftRight  (Nat.mul 32 C)) 4294967295)
    (Nat.ble C 1023)

/-- The quadratic form at `u` of the digits `d`, `t`: `∑ uᵢ²dᵢ + ∑_{i<j} uᵢuⱼ(tᵢⱼ-dᵢ-dⱼ)`. -/
noncomputable def formZ (d0 d1 d2 t01 t02 t12 : Nat) (u0 u1 u2 : Int) : Int :=
  u0 * u0 * d0 + u1 * u1 * d1 + u2 * u2 * d2 + u0 * u1 * ((t01 : Int) - d0 - d1)
    + u0 * u2 * ((t02 : Int) - d0 - d2) + u1 * u2 * ((t12 : Int) - d1 - d2)

/-- The form of one kernel at the row `(a,b,c)`, read from its two tables. -/
noncomputable def kerForm (T0 T1 a b c : Nat) (u0 u1 u2 : Int) : Int :=
  formZ (rdC T0 a b c) (rdC T0 b a c) (rdC T0 c b a) (rdC T1 a b c) (rdC T1 a c b) (rdC T1 c b a)
    u0 u1 u2

/-- The rounding constants `E^{ij}` (upper bounds, `10⁻²⁰`-grid). -/
def E10 : Rat := 8627525101 / 100000000000000000000
def E20 : Rat := 6402549530670 / 100000000000000000000
def E31 : Rat := 4243239449817840128 / 100000000000000000000
def E30 : Rat := 52950986516337952 / 100000000000000000000

/-- `h_C`. -/
def hQ (HC : Nat) : Rat := (HC : Rat) / 1000

/-- `e = h_C - b`. -/
def eQ (HC : Nat) : Rat := hQ HC - 117 / 500

/-- `δ = h_C - a C - b`. -/
def dQ (C HC : Nat) : Rat := hQ HC - 29 / 100 * (C : Rat) - 117 / 500

/-- `ω = 3λ_C/(2+λ_C)`. -/
def omQ (rC : Nat) : Rat := 3 * (rC : Rat) / (200000 + (rC : Rat))

/-- `a²`. -/
def a2Q : Rat := 29 / 100 * (29 / 100)

/-- The tail per unit `|c|²`, with `S₄ ≤ 15/ρ`, `S₆ ≤ 15/ρ³`, `ρ = 78 - cK`. -/
def tailQ (C HC rC cK : Nat) : Rat :=
  let rho : Rat := ((78 - cK : Nat) : Rat)
  omQ rC * omQ rC * (1 + dQ C HC * dQ C HC / (a2Q * (rho * rho * rho * rho))) * ((C : Rat) *
    (4 * (15 / rho) + (C : Rat) * (15 / (rho * rho * rho)))) / 3

/-- The rounding error per unit `|c|²`. -/
def errQ (C HC rC : Nat) : Rat :=
  omQ rC * omQ rC * ((2 * (eQ HC * eQ HC) * E10 + 2 * a2Q * E30) * (C : Rat)
    + 2 * (dQ C HC * dQ C HC) * E20 + 2 * a2Q * E31)

/-- `Γ`. -/
def gamQ (C HC rC G cK : Nat) : Rat :=
  36 * ((G : Rat) / 1000000000) * hQ HC - tailQ C HC rC cK - errQ C HC rC

/-- The twelve tables. -/
structure Tabs where
  a10 : Nat
  b10 : Nat
  a20 : Nat
  b20 : Nat
  a30 : Nat
  b30 : Nat
  a11 : Nat
  b11 : Nat
  a31 : Nat
  b31 : Nat
  a22 : Nat
  b22 : Nat

/-- The form of `X` at `u`, with the low digit `dX`. -/
noncomputable def formX (T : Tabs) (a b c : Nat) (e om2 dX : Rat) (u0 u1 u2 : Int) : Rat :=
  om2 * (2 * (e * e) * ((kerForm T.a10 T.b10 a b c u0 u1 u2 : Rat) / 618970019642690137449562112)
    - 4 * (29 / 100) * e * ((kerForm T.a20 T.b20 a b c u0 u1 u2 : Rat) / 604462909807314587353088)
    + 2 * a2Q * ((kerForm T.a30 T.b30 a b c u0 u1 u2 : Rat) / 147573952589676412928)) + dX

/-- The form of `Y` at `u`, with the low digit `dY`. -/
noncomputable def formY (T : Tabs) (a b c : Nat) (dl om2 dY : Rat) (u0 u1 u2 : Int) : Rat :=
  om2 * (2 * (dl * dl) * ((kerForm T.a20 T.b20 a b c u0 u1 u2 : Rat) / 604462909807314587353088
      - (kerForm T.a11 T.b11 a b c u0 u1 u2 : Rat) / 1208925819614629174706176)
    + 2 * a2Q * ((kerForm T.a31 T.b31 a b c u0 u1 u2 : Rat) / 1152921504606846976
      - (kerForm T.a22 T.b22 a b c u0 u1 u2 : Rat) / 9223372036854775808)) + dY

/-- The `2×2` test on `al x² + be y² + ga x y ≤ Γ (x² r2 + y² s2)`. -/
def test2 (Gam al be ga r2 s2 : Rat) : Bool :=
  decide (0 ≤ Gam * r2 - al) && decide (0 ≤ Gam * s2 - be) &&
    decide (ga * ga ≤ 4 * (Gam * r2 - al) * (Gam * s2 - be))

/-- The rational test from the six forms. -/
def testF (Gam Xr Xs Xt Yr Ys Yt : Rat) (C : Nat) (r2 : Rat) : Bool :=
  test2 Gam (Xs + Yr) ((C : Rat) * (C : Rat) * Xr + Ys)
    ((Yt - Yr - Ys) - (C : Rat) * (Xt - Xr - Xs)) r2 ((C : Rat) * r2)

/-- The low digit `i`, scaled by `9 r_C² / 2¹⁰⁰`. -/
noncomputable def lowD (S rC i : Nat) : Rat :=
  9 * (rC : Rat) * (rC : Rat) / (lowS : Rat) * ((rd 128 i S : Nat) : Rat)

/-- The row test at the sorted representative `(a,b,c)`. -/
noncomputable def rowTestS (T : Tabs) (a b c cK C HC rC Q ac bc S : Nat) : Bool :=
  testF (gamQ C HC rC (gN C) cK)
    (formX T a b c (eQ HC) (omQ rC * omQ rC) (lowD S rC 1) (-(b : Int)) (a : Int) 0)
    (formX T a b c (eQ HC) (omQ rC * omQ rC) (lowD S rC 0) (-(ac : Int)) (-(bc : Int)) (Q : Int))
    (formX T a b c (eQ HC) (omQ rC * omQ rC) (lowD S rC 2) (-(b : Int) - ac) ((a : Int) - bc) (Q : Int))
    (formY T a b c (dQ C HC) (omQ rC * omQ rC) (lowD S rC 4) (-(b : Int)) (a : Int) 0)
    (formY T a b c (dQ C HC) (omQ rC * omQ rC) (lowD S rC 3) (-(ac : Int)) (-(bc : Int)) (Q : Int))
    (formY T a b c (dQ C HC) (omQ rC * omQ rC) (lowD S rC 5) (-(b : Int) - ac) ((a : Int) - bc) (Q : Int))
    C (Q : Rat)

/-- The row test. -/
noncomputable def rowTest (T : Tabs) (a b c cK : Nat) : Bool :=
  litB (Nat.add (Nat.mul a a) (Nat.add (Nat.mul b b) (Nat.mul c c))) (fun C =>
  litB (Nat.add (Nat.mul a a) (Nat.mul b b)) (fun Q =>
  litB (Nat.mul a c) (fun ac => litB (Nat.mul b c) (fun bc =>
  litB (metric C) (fun HC => litB (root C) (fun rC =>
  litB (lowSum a b c C HC rC Q ac bc) (fun S =>
    Bool.and (Nat.ble (Nat.add S 1) 528294531135665246352339784916516606518847326036121522127960709026673902556724859474417255887657187894674394993257128678882347559502685537250538978462939576908386683999005084168731517676426441053024232908211188404148028292751561738838396898767036476489538580897737998336)
      (Bool.and (Nat.ble C (Nat.mul cK cK)) (Bool.and (Nat.ble (Nat.add cK 34) 78)
        (rowTestS T a b c cK C HC rC Q ac bc S))))))))))

end Row
end OVNS
