/-- The table lookup (`M₀` for non-occurring `C`). -/
noncomputable def gTable (C : ℕ) : ℝ :=
  match gTableN.find? (fun e => e.1 == C) with
  | some e => (e.2 : ℝ) / 1000000000
  | none => M₀

/-- The per-output price function of the certificates. -/
noncomputable def gOVNS (C : ℕ) : ℝ :=
  if C < 1024 then gTable C else if C < 3600 then 172754764 / 1000000000 else 163043 / 1000000

set_option maxRecDepth 100000 in
theorem gTableN_le : ∀ e ∈ gTableN, e.2 ≤ 185955292 := by
  have h : gTableN.all (fun e ↦ Nat.ble e.2 185955292) = true := by rfl
  intro e he
  exact Nat.le_of_ble_eq_true (List.all_eq_true.mp h e he)

/-- Every table price lies in `[0, M₀]`. -/
private lemma gTable_mem (C : ℕ) : 0 ≤ gTable C ∧ gTable C ≤ M₀ := by
  unfold gTable
  split
  · rename_i e he
    have hmem : e ∈ gTableN := List.mem_of_find?_eq_some he
    have hle : (e.2 : ℝ) ≤ 185955292 := by exact_mod_cast gTableN_le e hmem
    refine ⟨by positivity, ?_⟩
    unfold M₀
    exact div_le_div_of_nonneg_right hle (by norm_num)
  · exact ⟨by norm_num [M₀], le_rfl⟩

theorem gOVNS_le_M₀ (C : ℕ) : gOVNS C ≤ M₀ := by
  unfold gOVNS
  split_ifs
  · exact (gTable_mem C).2
  · norm_num [M₀]
  · norm_num [M₀]

theorem gOVNS_nonneg (C : ℕ) : 0 ≤ gOVNS C := by
  unfold gOVNS
  split_ifs
  · exact (gTable_mem C).1
  · norm_num
  · norm_num

end OVNS
