import OddViscousNS.Quant.Arith.Resonant.Orbit

/-!
# From the resonant pairing to the `γ`-weighted triad sum

`pair σ F (Qres F F) = (∑' x, |x₁+x₂|^{2σ} tripT resM F F F x₁ x₂).re` (`pair_eq_tsum`,
`inner_Qm`).  Averaging the absolutely summable series over the six relabellings generated by
`rho`, `iota` and regrouping each orbit (`orbit_regroup`) turns every orbit into
`∑_s [ResPat] orbitSum σ`; the orbit identity, the pattern structure and the helicity contraction
give the pointwise bound by `gammaR (legs x) ∏ u`.  Hence
`|⟨Q_r(F,F), A F⟩| ≤ ∑' x, gammaR (legs x) ∏_j |ℓ_j| ‖F ℓ_j‖` (and the `H²` analogue with
`gammaR2`, which needs `Adm 3 F` and the `σ = 2` summability of the triad series).
-/

open Finset

namespace OVNS.Quant

/-- The six relabellings of a triad generated by `rho` (cyclic) and `iota` (swap). -/
def relab : Fin 6 → Equiv.Perm (Mode × Mode) :=
  ![1, rho, rho ^ 2, iota, rho * iota, rho ^ 2 * iota]

/-- The permutations of the legs induced by the relabellings. -/
private def legPerm : Fin 6 → Equiv.Perm (Fin 3) :=
  ![1, Equiv.swap 0 1 * Equiv.swap 1 2, (Equiv.swap 0 1 * Equiv.swap 1 2) ^ 2,
    Equiv.swap 1 2, Equiv.swap 0 2, Equiv.swap 0 1]

private lemma legPerm_bijective : Function.Bijective legPerm := by
  rw [Fintype.bijective_iff_injective_and_card]
  refine ⟨by decide, ?_⟩
  simp [Fintype.card_perm, Nat.factorial]

private lemma legs_relab (i : Fin 6) (x : Mode × Mode) (j : Fin 3) :
    legs (relab i x) j = legs x (legPerm i j) := by
  obtain ⟨p, q⟩ := x
  fin_cases i <;> fin_cases j <;>
    simp [relab, legPerm, legs, rho, iota, Equiv.swap_apply_def, Equiv.Perm.mul_apply, pow_two,
      add_comm]


/-- Triples of signs as patterns. -/
private def sgnEquiv : Sgn × Sgn × Sgn ≃ (Fin 3 → Sgn) where
  toFun t := ![t.1, t.2.1, t.2.2]
  invFun s := (s 0, s 1, s 2)
  left_inv t := by simp
  right_inv s := by ext j; fin_cases j <;> rfl

private lemma sum_sgn3 (f : (Fin 3 → Sgn) → ℂ) :
    ∑ s, f s = ∑ a : Sgn, ∑ b : Sgn, ∑ c : Sgn, f ![a, b, c] := by
  rw [← Fintype.sum_equiv sgnEquiv (fun t => f (sgnEquiv t)) f (fun _ => rfl)]
  simp only [Fintype.sum_prod_type]
  rfl

private lemma Phi_eq_sum (a b c : Sgn) (p q : Mode) :
    Phi a b c p q = ∑ j, lam (![a, b, c] j) (legs (p, q) j) := by
  have h : lam c (-(p + q)) = -lam c (p + q) := lam_neg c (p + q)
  simp only [Phi, Fin.sum_univ_three]
  change _ = lam a p + lam b q + lam c (-(p + q))
  rw [h]
  ring

/-- The weighted triad summand as a sum over resonant patterns (identity ordering). -/
private lemma weighted_tripT (σ : ℝ) (F : Field) (p q : Mode) :
    ((sobWeight σ (p + q) : ℝ) : ℂ) * tripT resM F F F p q =
      ∑ s : Fin 3 → Sgn, if ResPat (legs (p, q)) s then
        ((sobWeight σ (legs (p, q) 2) : ℝ) : ℂ) *
          tau (legs (p, q) 0) (legs (p, q) 1) (hel (s 0) (legs (p, q) 0) (F (legs (p, q) 0)))
            (hel (s 1) (legs (p, q) 1) (F (legs (p, q) 1)))
            (hel (s 2) (legs (p, q) 2) (F (legs (p, q) 2))) else 0 := by
  rw [sum_sgn3, tripT, Finset.mul_sum]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun b _ => ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun c _ => ?_
  have hw : sobWeight σ (legs (p, q) 2) = sobWeight σ (p + q) := by
    exact sobWeight_neg σ (p + q)
  rw [hw]
  simp only [ResPat, ← Phi_eq_sum, resM]
  split_ifs <;> simp [legs]


/-- The ordered summand of an orbit sum (ordering `π`, pattern `t`). -/
private noncomputable def ordTerm (σ : ℝ) (F : Field) (ℓ : Fin 3 → Mode) (π : Equiv.Perm (Fin 3))
    (t : Fin 3 → Sgn) : ℂ :=
  ((sobWeight σ (ℓ (π 2)) : ℝ) : ℂ) *
    tau (ℓ (π 0)) (ℓ (π 1)) (hel (t (π 0)) (ℓ (π 0)) (F (ℓ (π 0))))
      (hel (t (π 1)) (ℓ (π 1)) (F (ℓ (π 1)))) (hel (t (π 2)) (ℓ (π 2)) (F (ℓ (π 2))))

private lemma resPat_comp (ℓ : Fin 3 → Mode) (π : Equiv.Perm (Fin 3)) (s : Fin 3 → Sgn) :
    ResPat (fun j => ℓ (π j)) s ↔ ResPat ℓ (fun j => s (π.symm j)) := by
  unfold ResPat
  rw [← Equiv.sum_comp π (fun j => lam (s (π.symm j)) (ℓ j))]
  simp only [Equiv.symm_apply_apply]

private lemma term_relab (σ : ℝ) (F : Field) (x : Mode × Mode) (i : Fin 6) :
    ((sobWeight σ ((relab i x).1 + (relab i x).2) : ℝ) : ℂ) *
        tripT resM F F F (relab i x).1 (relab i x).2 =
      ∑ t : Fin 3 → Sgn, if ResPat (legs x) t then ordTerm σ F (legs x) (legPerm i) t
        else 0 := by
  rw [weighted_tripT]
  have hl : legs ((relab i x).1, (relab i x).2) = fun j => legs x (legPerm i j) :=
    funext (legs_relab i x)
  rw [hl]
  refine Fintype.sum_equiv (Equiv.arrowCongr (legPerm i) (Equiv.refl Sgn)) _ _ fun s => ?_
  refine if_congr ?_ ?_ rfl
  · rw [resPat_comp]
    rfl
  · simp [ordTerm]

private lemma sum_legPerm {M : Type*} [AddCommMonoid M] (f : Equiv.Perm (Fin 3) → M) :
    ∑ i : Fin 6, f (legPerm i) = ∑ π, f π :=
  Fintype.sum_bijective legPerm legPerm_bijective _ _ fun _ => rfl

private lemma orbit_regroup' (σ : ℝ) (F : Field) (x : Mode × Mode) :
    ∑ i : Fin 6, ((sobWeight σ ((relab i x).1 + (relab i x).2) : ℝ) : ℂ) *
        tripT resM F F F (relab i x).1 (relab i x).2 =
      ∑ s : Fin 3 → Sgn, if ResPat (legs x) s then
        orbitSum σ (legs x) (fun j => hel (s j) (legs x j) (F (legs x j))) else 0 := by
  simp only [term_relab]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun t _ => ?_
  split_ifs with h
  · rw [sum_legPerm (fun π => ordTerm σ F (legs x) π t)]
    rfl
  · simp

/-- Orbit regrouping: the six relabellings of `x` collect the resonant orbit sums. -/
theorem orbit_regroup (σ : ℝ) (F : Field) (x : Mode × Mode) (hx : ∀ j, legs x j ≠ 0) :
    ∑ i : Fin 6, ((sobWeight σ ((relab i x).1 + (relab i x).2) : ℝ) : ℂ) *
        tripT resM F F F (relab i x).1 (relab i x).2 =
      ∑ s : Fin 3 → Sgn, if ResPat (legs x) s then
        orbitSum σ (legs x) (fun j => hel (s j) (legs x j) (F (legs x j))) else 0 := by
  exact (fun _ => orbit_regroup' σ F x) hx


private lemma sobWeight_three (k : Mode) : sobWeight 3 k = absk k ^ 6 := by
  unfold sobWeight
  split_ifs with hk
  · subst hk
    simp [absk, absSq]
  · rw [show (2 * 3 : ℝ) = (6 : ℕ) by norm_num, Real.rpow_natCast]

private lemma summable_cube_sq {F : Field} (hF : InH 3 F) :
    Summable fun k : Mode => (absk k ^ 3 * ‖F (-k)‖) ^ 2 := by
  have h : Summable fun k => sobWeight 3 (-k) * ‖F (-k)‖ ^ 2 :=
    Summable.comp_injective (i := fun k : Mode => -k) hF neg_injective
  refine h.congr fun k => ?_
  rw [sobWeight_neg, sobWeight_three]
  ring

private lemma summable_absSq_sq {F : Field} (hF : InH 2 F) :
    Summable fun k : Mode => (absSq k * ‖F k‖) ^ 2 := by
  refine hF.congr fun k => ?_
  rw [sobWeight_two]
  ring

private lemma triM_two_le (F : Field) (p q : Mode) :
    triM 2 F F F (p, q) ≤ 2 * (‖F p‖ * (absSq q * ‖F q‖) * (absk (p + q) ^ 3 * ‖F (-(p + q))‖) +
      ‖F q‖ * (absSq p * ‖F p‖) * (absk (q + p) ^ 3 * ‖F (-(q + p))‖)) := by
  have hP := absk_nonneg p
  have hQ := absk_nonneg q
  have hR := absk_nonneg (p + q)
  have hRle := absk_add_le p q
  have hw : sobWeight 2 (p + q) = absk (p + q) ^ 4 := by
    rw [sobWeight_two, ← absk_sq]
    ring
  have hqp : q + p = p + q := add_comm q p
  rw [hqp, ← absk_sq p, ← absk_sq q]
  simp only [triM, hw]
  have hN : 0 ≤ ‖F p‖ * ‖F q‖ * ‖F (-(p + q))‖ := by positivity
  have key : absk (p + q) ^ 4 * (absk p + absk q) ≤
      2 * absk (p + q) ^ 3 * (absk p ^ 2 + absk q ^ 2) := by
    have h1 : absk (p + q) ^ 4 * (absk p + absk q) ≤
        absk (p + q) ^ 3 * (absk p + absk q) ^ 2 := by
      have := mul_le_mul_of_nonneg_left hRle (by positivity : 0 ≤ absk (p + q) ^ 3 *
        (absk p + absk q))
      nlinarith
    have h2 : (absk p + absk q) ^ 2 ≤ 2 * (absk p ^ 2 + absk q ^ 2) := by
      nlinarith [sq_nonneg (absk p - absk q)]
    have := mul_le_mul_of_nonneg_left h2 (by positivity : 0 ≤ absk (p + q) ^ 3)
    nlinarith
  have := mul_le_mul_of_nonneg_right key hN
  calc _ = absk (p + q) ^ 4 * (absk p + absk q) * (‖F p‖ * ‖F q‖ * ‖F (-(p + q))‖) := by ring
    _ ≤ _ := this
    _ = _ := by ring

private lemma summable_triM_two {F : Field} (hF : Adm 3 F) : Summable (triM 2 F F F) := by
  have h2 : InH 2 F := InH.mono (by norm_num) hF.inH
  have hc0 : ∀ k, 0 ≤ absk k ^ 3 * ‖F (-k)‖ := fun k =>
    mul_nonneg (pow_nonneg (absk_nonneg k) 3) (norm_nonneg _)
  have ha0 : ∀ k, 0 ≤ absSq k * ‖F k‖ := fun k => mul_nonneg (absSq_nonneg k) (norm_nonneg _)
  have h1 := (triple_bound (fun k => norm_nonneg (F k)) ha0 hc0
    (summable_wiener h2) (summable_absSq_sq h2) (summable_cube_sq hF.inH)).1
  have h1' := (Equiv.prodComm Mode Mode).summable_iff.mpr h1
  refine Summable.of_nonneg_of_le (triM_nonneg 2 F F F) (fun x => ?_)
    ((h1.add h1').mul_left 2)
  exact triM_two_le F x.1 x.2

/-- Summability of the `σ = 2` weighted triad series for `H³` fast fields. -/
theorem summable_tripT_two {F : Field} (hF : Adm 3 F) :
    Summable fun x : Mode × Mode =>
      ((sobWeight 2 (x.1 + x.2) : ℝ) : ℂ) * tripT resM F F F x.1 x.2 := by
  refine Summable.of_norm_bounded ((summable_triM_two hF).mul_left 8) fun x => ?_
  rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (sobWeight_nonneg _ _)]
  have := mul_le_mul_of_nonneg_left (norm_tripT_le resM_bdd F F F x.1 x.2)
    (sobWeight_nonneg 2 (x.1 + x.2))
  simp only [triM]
  linarith


/-! ### Pointwise bounds on an orbit -/

private lemma hel_neg_mode (a : Sgn) (k : Mode) (v : V3) : hel a (-k) v = hel (!a) k v := by
  by_cases hk : k = 0
  · subst hk
    simp [hel_zero_mode]
  have hk' : -k ≠ 0 := neg_ne_zero.mpr hk
  apply v3_ext <;>
    simp [hel, hk, hk', leray, modeVec_apply, cross_apply_zero, cross_apply_one,
      cross_apply_two, dotM_eq, absk_neg, absSq_neg] <;> cases a <;> simp [sg] <;> ring

private lemma exists_hel_norm (a : Sgn) {k : Mode} (hk : k ≠ 0) {w : V3} (hw : dotM w k = 0) :
    ∃ v : V3, ‖hel a k v‖ = ‖w‖ := by
  have hsq := norm_sq_hel_sum k w
  rw [leray_of_perp hk hw, Fintype.sum_bool] at hsq
  by_cases h : hel a k w = 0
  · refine ⟨conjV w, ?_⟩
    have e : hel a k (conjV w) = conjV (hel (!a) k w) := by
      rw [conjV_hel, hel_neg_mode, Bool.not_not]
    rw [e, norm_conjV]
    have h2 : ‖hel (!a) k w‖ ^ 2 = ‖w‖ ^ 2 := by
      cases a <;> simp_all
    exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp h2
  · have hpos : 0 < ‖hel a k w‖ := norm_pos_iff.mpr h
    refine ⟨((‖w‖ / ‖hel a k w‖ : ℝ) : ℂ) • hel a k w, ?_⟩
    rw [hel_smul, hel_idem, norm_smul, Complex.norm_real, Real.norm_of_nonneg (by positivity),
      div_mul_cancel₀ _ hpos.ne']

private lemma orbitSum_eq_zero (σ : ℝ) (ℓ : Fin 3 → Mode) {A : Fin 3 → V3} {j : Fin 3}
    (hA : A j = 0) : orbitSum σ ℓ A = 0 := by
  refine Finset.sum_eq_zero fun π _ => ?_
  have hj : ∀ i, π.symm j = i → A (π i) = 0 := fun i h => by rw [← h, π.apply_symm_apply, hA]
  have h3 : ∀ i : Fin 3, i = 0 ∨ i = 1 ∨ i = 2 := by decide
  rcases h3 (π.symm j) with h | h | h <;> have := hj _ h <;>
    simp [this, tau_zero_left, tau_zero_mid, tau_zero_right]

private lemma norm_orbitSum_le (σ : ℝ) (ℓ : Fin 3 → Mode) (A : Fin 3 → V3) :
    ‖orbitSum σ ℓ A‖ ≤ ∑ π : Equiv.Perm (Fin 3),
      sobWeight σ (ℓ (π 2)) * (absk (ℓ (π 0)) + absk (ℓ (π 1))) * ∏ j, ‖A j‖ := by
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun π _ => ?_)
  have hp : ∏ j, ‖A j‖ = ‖A (π 0)‖ * ‖A (π 1)‖ * ‖A (π 2)‖ := by
    rw [← Equiv.prod_comp π (fun j => ‖A j‖), Fin.prod_univ_three]
  rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (sobWeight_nonneg _ _), hp]
  have := norm_tau_le (ℓ (π 0)) (ℓ (π 1)) (A (π 0)) (A (π 1)) (A (π 2))
  have hw := sobWeight_nonneg σ (ℓ (π 2))
  calc _ ≤ sobWeight σ (ℓ (π 2)) * ((absk (ℓ (π 0)) + absk (ℓ (π 1))) * ‖A (π 0)‖ *
        ‖A (π 1)‖ * ‖A (π 2)‖) := mul_le_mul_of_nonneg_left this hw
    _ = _ := by ring

/-- The symmetric majorant of an orbit. -/
private noncomputable def orbM (σ : ℝ) (F : Field) (x : Mode × Mode) : ℝ :=
  ∑ π : Equiv.Perm (Fin 3), sobWeight σ (legs x (π 2)) *
    (absk (legs x (π 0)) + absk (legs x (π 1))) * ∏ j, ‖F (legs x j)‖

private lemma triM_relab (σ : ℝ) (F : Field) (x : Mode × Mode) (i : Fin 6) :
    triM σ F F F (relab i x) = sobWeight σ (legs x (legPerm i 2)) *
      (absk (legs x (legPerm i 0)) + absk (legs x (legPerm i 1))) * ∏ j, ‖F (legs x j)‖ := by
  set y := relab i x with hy
  have e : triM σ F F F y = sobWeight σ (legs y 2) * ((absk (legs y 0) + absk (legs y 1)) *
      ‖F (legs y 0)‖ * ‖F (legs y 1)‖ * ‖F (legs y 2)‖) := by
    rw [show legs y 2 = -(y.1 + y.2) from rfl, sobWeight_neg]
    rfl
  rw [e, hy, legs_relab, legs_relab, legs_relab,
    ← Equiv.prod_comp (legPerm i) (fun j => ‖F (legs x j)‖), Fin.prod_univ_three]
  ring

private lemma summable_orbM {σ : ℝ} {F : Field} (hM : Summable (triM σ F F F)) :
    Summable (orbM σ F) := by
  have e : orbM σ F = fun x => ∑ i : Fin 6, triM σ F F F (relab i x) := by
    funext x
    simp only [triM_relab]
    exact (sum_legPerm (fun π => sobWeight σ (legs x (π 2)) *
      (absk (legs x (π 0)) + absk (legs x (π 1))) * ∏ j, ‖F (legs x j)‖)).symm
  rw [e]
  refine summable_sum fun i _ => ?_
  have := ((relab i).summable_iff (f := triM σ F F F)).mpr hM
  exact this

/-- Half the sum of a pattern coefficient over the resonant patterns. -/
private noncomputable def gR (g : (Fin 3 → Mode) → (Fin 3 → Sgn) → ℝ) (ℓ : Fin 3 → Mode) : ℝ :=
  (1 / 2) * ∑ s : Fin 3 → Sgn, if ResPat ℓ s then g ℓ s else 0

private lemma sum_res_pair {M : Type*} [AddCommMonoid M] {ℓ : Fin 3 → Mode}
    (hfast : ∀ j, ℓ j 2 ≠ 0) {s : Fin 3 → Sgn} (hs : ResPat ℓ s) (h : (Fin 3 → Sgn) → M) :
    ∑ t, (if ResPat ℓ t then h t else 0) = h s + h (fun j => !s j) := by
  have hne : s ≠ fun j => !s j := fun e => by
    have := congrFun e 0
    simp at this
  rw [Fintype.sum_eq_add s (fun j => !s j) hne]
  · simp only [hs, (resPat_neg ℓ s).mpr hs, ↓reduceIte]
  · rintro t ⟨h1, h2⟩
    have ht : ¬ ResPat ℓ t := fun ht => by
      rcases resPat_unique ℓ hfast hs ht with e | e
      exacts [h1 e, h2 e]
    simp only [ht, ↓reduceIte]

private lemma legs_sum (x : Mode × Mode) : ∑ j, legs x j = 0 := by
  rw [Fin.sum_univ_three]
  show x.1 + x.2 + -(x.1 + x.2) = 0
  abel


private lemma orbM_nonneg (σ : ℝ) (F : Field) (x : Mode × Mode) : 0 ≤ orbM σ F x :=
  Finset.sum_nonneg fun π _ => by
    have := sobWeight_nonneg σ (legs x (π 2))
    have := absk_nonneg (legs x (π 0))
    have := absk_nonneg (legs x (π 1))
    have : 0 ≤ ∏ j, ‖F (legs x j)‖ := Finset.prod_nonneg fun j _ => norm_nonneg _
    positivity

/-- The orbit bound and the reverse majorant bound at one triad. -/
private lemma orbit_pointwise (σ : ℝ) {F : Field} (hF : Adm 2 F) (hF' : PiF F = F)
    (g : (Fin 3 → Mode) → (Fin 3 → Sgn) → ℝ) (hg0 : ∀ ℓ s, 0 ≤ g ℓ s)
    (hgn : ∀ ℓ s, g ℓ (fun j => !s j) = g ℓ s)
    (horb : ∀ ℓ : Fin 3 → Mode, ∑ j, ℓ j = 0 → (∀ j, ℓ j ≠ 0) →
      ∀ (s : Fin 3 → Sgn) (v : Fin 3 → V3),
      ‖orbitSum σ ℓ (fun j => hel (s j) (ℓ j) (v j))‖ =
        6 * g ℓ s * (∏ j, absk (ℓ j)) * ∏ j, ‖hel (s j) (ℓ j) (v j)‖)
    (x : Mode × Mode) :
    ‖∑ s : Fin 3 → Sgn, if ResPat (legs x) s then
        orbitSum σ (legs x) (fun j => hel (s j) (legs x j) (F (legs x j))) else 0‖ ≤
      6 * (gR g (legs x) * ∏ j, uAmp F (legs x j)) ∧
    gR g (legs x) * ∏ j, uAmp F (legs x j) ≤ (1 / 6) * orbM σ F x := by
  have hO0 := orbM_nonneg σ F x
  have hO : orbM σ F x = ∑ π : Equiv.Perm (Fin 3), sobWeight σ (legs x (π 2)) *
      (absk (legs x (π 0)) + absk (legs x (π 1))) * ∏ j, ‖F (legs x j)‖ := rfl
  set ℓ := legs x with hℓ
  have hsum : ∑ j, ℓ j = 0 := legs_sum x
  have hu : ∏ j, uAmp F (ℓ j) = (∏ j, absk (ℓ j)) * ∏ j, ‖F (ℓ j)‖ := Finset.prod_mul_distrib
  by_cases hfast : ∀ j, ℓ j 2 ≠ 0
  swap
  · push Not at hfast
    obtain ⟨j, hj⟩ := hfast
    have hFj : F (ℓ j) = 0 := fast_zero hF' hj
    have hprod : ∏ j, uAmp F (ℓ j) = 0 :=
      Finset.prod_eq_zero (Finset.mem_univ j) (by simp [uAmp, hFj])
    rw [hprod, mul_zero, mul_zero]
    refine ⟨?_, by linarith⟩
    rw [Finset.sum_eq_zero fun s _ => ?_, norm_zero]
    split_ifs
    · exact orbitSum_eq_zero σ ℓ (j := j) (by simp [hFj, hel_zero_right])
    · rfl
  have hne : ∀ j, ℓ j ≠ 0 := fun j h => hfast j (by simp [h])
  by_cases hres : ∃ s, ResPat ℓ s
  swap
  · push Not at hres
    have hg : gR g ℓ = 0 := by simp [gR, hres]
    simp [hres, hg, hO0]
  obtain ⟨s, hs⟩ := hres
  have hg : gR g ℓ = g ℓ s := by
    rw [gR, sum_res_pair hfast hs (fun t => g ℓ t), hgn]
    ring
  have hP : 0 ≤ ∏ j, absk (ℓ j) := Finset.prod_nonneg fun j _ => absk_nonneg _
  have hgs := hg0 ℓ s
  rw [hg]
  constructor
  · rw [sum_res_pair hfast hs (fun t => orbitSum σ ℓ (fun j => hel (t j) (ℓ j) (F (ℓ j))))]
    refine (norm_add_le _ _).trans ?_
    rw [horb ℓ hsum hne, horb ℓ hsum hne, hgn, hu]
    have hc := hel_contraction ℓ hne s hF.sol
    have h6 : 0 ≤ 6 * g ℓ s * ∏ j, absk (ℓ j) := by positivity
    have := mul_le_mul_of_nonneg_left hc h6
    linarith
  · choose v hv using fun j => exists_hel_norm (s j) (hne j) (hF.sol (ℓ j))
    have h1 := horb ℓ hsum hne s v
    have h2 := norm_orbitSum_le σ ℓ (fun j => hel (s j) (ℓ j) (v j))
    simp only [hv] at h1 h2
    rw [hu, hO]
    linarith


/-- The coefficient inequality for a general orbit coefficient `g`. -/
private lemma pair_le_gR (σ : ℝ) {F : Field} (hF : Adm 2 F) (hF' : PiF F = F)
    (g : (Fin 3 → Mode) → (Fin 3 → Sgn) → ℝ) (hg0 : ∀ ℓ s, 0 ≤ g ℓ s)
    (hgn : ∀ ℓ s, g ℓ (fun j => !s j) = g ℓ s)
    (horb : ∀ ℓ : Fin 3 → Mode, ∑ j, ℓ j = 0 → (∀ j, ℓ j ≠ 0) →
      ∀ (s : Fin 3 → Sgn) (v : Fin 3 → V3),
      ‖orbitSum σ ℓ (fun j => hel (s j) (ℓ j) (v j))‖ =
        6 * g ℓ s * (∏ j, absk (ℓ j)) * ∏ j, ‖hel (s j) (ℓ j) (v j)‖)
    (hM : Summable (triM σ F F F)) :
    Summable (fun x : Mode × Mode => gR g (legs x) * ∏ j, uAmp F (legs x j)) ∧
    |pair σ F (Qres F F)| ≤ ∑' x : Mode × Mode, gR g (legs x) * ∏ j, uAmp F (legs x j) := by
  set T : Mode × Mode → ℂ := fun x =>
    ((sobWeight σ (x.1 + x.2) : ℝ) : ℂ) * tripT resM F F F x.1 x.2 with hTdef
  set G : Mode × Mode → ℝ := fun x => gR g (legs x) * ∏ j, uAmp F (legs x j) with hGdef
  have hT : Summable T := by
    refine Summable.of_norm_bounded (hM.mul_left 8) fun x => ?_
    rw [hTdef, norm_mul, Complex.norm_real, Real.norm_of_nonneg (sobWeight_nonneg _ _)]
    have := mul_le_mul_of_nonneg_left (norm_tripT_le resM_bdd F F F x.1 x.2)
      (sobWeight_nonneg σ (x.1 + x.2))
    simp only [triM]
    linarith
  have hpair : pair σ F (Qres F F) = (∑' x, T x).re :=
    pair_eq_tsum (tripT resM F F F) (inner_Qm resM_bdd hF.real hF.mz hF.mz) hT
  have hG0 : ∀ x, 0 ≤ G x := fun x => by
    have h := (orbit_pointwise σ hF hF' g hg0 hgn horb x).1
    have := norm_nonneg (∑ s : Fin 3 → Sgn, if ResPat (legs x) s then
        orbitSum σ (legs x) (fun j => hel (s j) (legs x j) (F (legs x j))) else 0)
    simp only [hGdef]
    linarith
  have hG : Summable G := Summable.of_nonneg_of_le hG0
    (fun x => (orbit_pointwise σ hF hF' g hg0 hgn horb x).2)
    ((summable_orbM hM).mul_left (1 / 6))
  refine ⟨hG, ?_⟩
  set O : Mode × Mode → ℂ := fun x => ∑ i : Fin 6, T (relab i x) with hOdef
  have hTi : ∀ i : Fin 6, Summable fun x => T (relab i x) := fun i =>
    ((relab i).summable_iff (f := T)).mpr hT
  have hOle : ∀ x, ‖O x‖ ≤ 6 * G x := fun x => by
    have h := (orbit_pointwise σ hF hF' g hg0 hgn horb x).1
    rw [← orbit_regroup' σ F x] at h
    exact h
  have hOn : Summable fun x => ‖O x‖ :=
    Summable.of_nonneg_of_le (fun x => norm_nonneg _) hOle (hG.mul_left 6)
  have hOsum : ∑' x, O x = 6 * ∑' x, T x := by
    rw [hOdef, Summable.tsum_finsetSum fun i _ => hTi i]
    have e : ∀ i : Fin 6, ∑' x, T (relab i x) = ∑' x, T x := fun i => (relab i).tsum_eq T
    simp only [e, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    norm_num
  have hle : ‖∑' x, O x‖ ≤ 6 * ∑' x, G x := by
    refine (norm_tsum_le_tsum_norm hOn).trans ?_
    rw [← tsum_mul_left]
    exact hOn.tsum_le_tsum hOle (hG.mul_left 6)
  rw [hpair]
  refine (Complex.abs_re_le_norm _).trans ?_
  rw [hOsum, norm_mul] at hle
  simp only [Complex.norm_ofNat] at hle
  linarith

/-- The `H¹` coefficient inequality. -/
theorem pair1_le_gamma_sum {F : Field} (hF : Adm 2 F) (hF' : PiF F = F) :
    Summable (fun x : Mode × Mode => gammaR (legs x) * ∏ j, uAmp F (legs x j)) ∧
    |pair 1 F (Qres F F)| ≤ ∑' x : Mode × Mode, gammaR (legs x) * ∏ j, uAmp F (legs x j) :=
  pair_le_gR 1 hF hF' gammaC gammaC_nonneg gammaC_neg
    (fun ℓ hs hn s v => orbit_vertex_H1 ℓ hs hn s v)
    (summable_triM (by norm_num) hF.mz hF.mz hF.mz)

/-- The `H²` coefficient inequality. -/
theorem pair2_le_gamma_sum {F : Field} (hF : Adm 3 F) (hF' : PiF F = F) :
    Summable (fun x : Mode × Mode => gammaR2 (legs x) * ∏ j, uAmp F (legs x j)) ∧
    |pair 2 F (Qres F F)| ≤ ∑' x : Mode × Mode, gammaR2 (legs x) * ∏ j, uAmp F (legs x j) := by
  have hF2 : Adm 2 F := ⟨InH.mono (by norm_num) hF.inH, hF.real, hF.sol, hF.mean⟩
  refine pair_le_gR 2 hF2 hF' (fun ℓ s => gammaC ℓ s * |h2C ℓ s|)
    (fun ℓ s => mul_nonneg (gammaC_nonneg ℓ s) (abs_nonneg _))
    (fun ℓ s => by simp only [gammaC_neg, h2C_neg]) (fun ℓ hs hn s v => ?_)
    (summable_triM_two hF)
  rw [orbit_vertex_H2 ℓ hs hn s v]
  ring

end OVNS.Quant
